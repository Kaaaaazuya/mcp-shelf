{
  "name": "mcp-shelf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "void prepare && tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "deploy": "void deploy",
    "check:deps": "node scripts/check-deps.mjs"
  },
  "dependencies": {
    "@void/react": "1.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "void": "1.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.17",
    "miniflare": "5.20261012.0-beta",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.10.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.21.0",
      "onFail": "error"
    }
  }
}
